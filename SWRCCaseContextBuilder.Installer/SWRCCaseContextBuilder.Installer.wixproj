<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <DefineConstants>PublishDir=$(MSBuildProjectDirectory)\..\SWRCCaseContextBuilder\bin\publish\</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
